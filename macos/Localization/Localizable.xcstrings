            "value": "正在配对…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在配對…"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զուգակցում…"
          }
        }
      }
    },
    "That address isn't a scanix500 network scan server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse ist kein scanix500-Netzwerk-Scan-Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa dirección no es un servidor de escaneo en red de scanix500."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse n'est pas un serveur de numérisation réseau scanix500."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址不是 scanix500 网络扫描服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該地址不是 scanix500 網絡掃描服務器。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հասցեն scanix500 ցանցային սկանավորման սերվեր չէ։"
          }
        }
      }
    },
    "The Scan button wasn't pressed within 2 minutes. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Scan-Taste wurde nicht innerhalb von 2 Minuten gedrückt. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pulsó el botón Scan en 2 minutos. Inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton Scan n'a pas été pressé dans les 2 minutes. Réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分钟内未按下扫描按钮。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分鐘內未按下掃描按鈕。請重試。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan կոճակը չի սեղմվել 2 րոպեի ընթացքում։ Փորձեք կրկին։"
          }
        }
      }
    },
    "Another computer tried to pair at the same time. Try again with only one computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Computer wollte gleichzeitig koppeln. Versuch es noch einmal mit nur einem Computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro ordenador pidió emparejarse al mismo tiempo. Inténtelo de nuevo con un solo ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre ordinateur a demandé l'association en même temps. Réessayez avec un seul ordinateur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台电脑同时请求配对。请只用一台电脑重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一臺電腦同時請求配對。請只用一臺電腦重試。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ այլ համակարգիչ միաժամանակ զուգակցում խնդրեց։ Փորձեք կրկին միայն մեկ համակարգչով։"
          }
        }
      }
    },
    "Too many pairing requests. Wait a minute, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Kopplungsanfragen. Warte eine Minute und versuch es dann noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes de emparejamiento. Espere un minuto y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de demandes d'association. Patientez une minute, puis réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对请求过多。请等待一分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對請求過多。請等待一分鐘後重試。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չափազանց շատ զուգակցման հարցումներ։ Սպասեք մեկ րոպե, ապա փորձեք կրկին։"
          }
        }
      }
    },
    "The network scanner can't be reached (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Netzwerkscanner ist nicht erreichbar (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede alcanzar el escáner de red (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner réseau est injoignable (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接网络扫描仪（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接網絡掃描儀（%@）。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցանցային սկաները հասանելի չէ (%@)։"
          }
        }
      }
    },
    "The network scanner presented a different certificate (%@) from the one used during pairing. If the server was reinstalled, remove the scanner from Dossiary Scan Helper and add it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Netzwerkscanner hat ein anderes Zertifikat (%@) vorgelegt als beim Koppeln. Wurde er neu installiert, entferne ihn in Dossiary Scan Helper und füge ihn neu hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner de red presentó un certificado distinto (%@) del que tenía al emparejarlo. Si se reinstaló, quítelo en Dossiary Scan Helper y vuelva a añadirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner réseau a présenté un certificat différent (%@) de celui de l'association. S'il a été réinstallé, retirez-le dans Dossiary Scan Helper puis ajoutez-le de nouveau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扫描仪出示的证书（%@）与配对时不同。如果它已重新安装，请在 Dossiary Scan Helper 中移除后重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網絡掃描儀出示的證書（%@）與配對時不同。如果它已重新安裝，請在 Dossiary Scan Helper 中移除後重新添加。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցանցային սկաները ներկայացրեց այլ վկայական (%@), քան զուգակցման ժամանակ։ Եթե այն վերատեղադրվել է, հեռացրեք այն Dossiary Scan Helper-ում և նորից ավելացրեք։"
          }
        }
      }
    },
