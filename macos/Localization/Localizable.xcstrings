    "Fake scanner mode: This code always works.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testscanner-Modus: Dieser Code funktioniert immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de escáneres de prueba: este código siempre funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode scanners de test : ce code fonctionne toujours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试扫描仪模式：此代码始终有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試掃描儀模式：此代碼始終有效。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փորձնական սկաներների ռեժիմ. այս կոդը միշտ աշխատում է։"
          }
        }
      }
    },
    "Type this code in Dossiary's scan dialog.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib diesen Code im Scan-Dialog von Dossiary ein."
