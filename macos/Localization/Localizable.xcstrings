    },
    "The fingerprint should match the output of “scanix500-server status” on the Pi. Then click the button below and, within 2 minutes, press the Scan button on the iX500—or enter a code from “sudo scanix500-server pair”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fingerabdruck sollte mit der Ausgabe von „scanix500-server status“ auf dem Pi übereinstimmen. Klicke dann unten auf die Schaltfläche und drücke innerhalb von 2 Minuten die Scan-Taste am iX500 – oder gib einen Code von „sudo scanix500-server pair“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La huella digital debe coincidir con la salida de «scanix500-server status» en la Pi. Luego haga clic en el botón de abajo y, en menos de 2 minutos, pulse el botón Scan del iX500, o escriba un código de «sudo scanix500-server pair»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'empreinte doit correspondre à la sortie de « scanix500-server status » sur le Pi. Cliquez ensuite sur le bouton ci-dessous puis, dans les 2 minutes, appuyez sur le bouton Scan de l'iX500 — ou saisissez un code obtenu avec « sudo scanix500-server pair »."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指纹应与树莓派上“scanix500-server status”的输出一致。然后点击下方按钮，并在 2 分钟内按下 iX500 上的扫描按钮——或输入“sudo scanix500-server pair”给出的代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋應與樹莓派上“scanix500-server status”的輸出一致。然後點擊下方按鈕，並在 2 分鐘內按下 iX500 上的掃描按鈕——或輸入“sudo scanix500-server pair”給出的代碼。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մատնահետքը պետք է համընկնի Pi-ի վրա «scanix500-server status»-ի ելքի հետ։ Ապա սեղմեք ներքևի կոճակը և 2 րոպեի ընթացքում սեղմեք iX500-ի Scan կոճակը, կամ մուտքագրեք «sudo scanix500-server pair»-ի տված կոդը։"
          }
        }
      }
    },
    "Press the Scan button on the iX500 within 2 minutes…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke innerhalb von 2 Minuten die Scan-Taste am iX500…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse el botón Scan del iX500 en menos de 2 minutos…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton Scan de l'iX500 dans les 2 minutes…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 2 分钟内按下 iX500 上的扫描按钮…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 2 分鐘內按下 iX500 上的掃描按鈕…"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "2 րոպեի ընթացքում սեղմեք iX500-ի Scan կոճակը…"
          }
        }
      }
    },
    "Pairing…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopple…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejando…"
          }
        },
        "fr": {
          "stringUnit": {
