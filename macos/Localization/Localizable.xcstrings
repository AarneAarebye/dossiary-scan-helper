    "No scanners are available yet. Add a network scanner or connect one first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Scanner verfügbar. Zuerst einen Netzwerkscanner hinzufügen oder einen anschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay escáneres disponibles. Primero se debe añadir un escáner de red o conectar uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun scanner disponible pour l'instant. Ajoutez d'abord un scanner réseau ou branchez-en un."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可用的扫描仪。请先添加网络扫描仪或连接一台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可用的掃描器。請先新增網路掃描器或連接一台。"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ հասանելի սկաներ չկա։ Նախ ավելացրեք ցանցային սկաներ կամ միացրեք մեկը։"
          }
        }
      }
